# 依赖
node_modules/
__pycache__/
*.pyc
.env

# 告警配置（里面有邮箱授权码）和监控状态
/alert.json
/data/

# 机器人目录：仓库里只放说明和 starter-bot 的模板，你自己建的机器人都不进 git
bots/*
!bots/README.md
!bots/starter-bot/
# starter-bot 里由安装脚本和扫码登录生成的配置、人设、记忆、任务和运行数据也不进 git
bots/starter-bot/config.json
bots/starter-bot/MEMORY.md
bots/starter-bot/tasks.js
bots/starter-bot/topics.json
bots/starter-bot/data/
**/qrcode.png

# 技能里的登录凭证
bilibili_config.json

# 打包输出
dist/
*.tar.gz
*.zip
.DS_Store
